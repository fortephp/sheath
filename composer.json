{
    "name": "fortephp/sheath",
    "description": "A Laravel-first Blade and HTML linter with rules for accessibility, security, SEO, performance, and template best practices.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "blade linter"
    ],
    "authors": [
        {
            "name": "John Koster",
            "email": "john@stillat.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "composer/semver": "^3.4",
        "laravel/framework": "^12.0 || ^13.0",
        "fortephp/forte": "^1.1",
        "symfony/finder": "^6.0 || ^7.0 || ^8.0",
        "ext-mbstring": "*"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0 || ^11.0",
        "pestphp/pest": "^3",
        "laravel/pint": "^1.22",
        "phpstan/phpstan": "^2.1",
        "rector/rector": "^2.1",
        "react/event-loop": "^1.5",
        "react/child-process": "^0.6",
        "clue/ndjson-react": "^1.3",
        "fidry/cpu-core-counter": "^1.2"
    },
    "suggest": {
        "react/event-loop": "Required for --parallel support (^1.5)",
        "react/child-process": "Required for --parallel support (^0.6)",
        "clue/ndjson-react": "Required for --parallel support (^1.3)",
        "fidry/cpu-core-counter": "Improves automatic CPU core detection for --parallel (^1.2)"
    },
    "autoload": {
        "psr-4": {
            "Forte\\Sheath\\": "src/"
        }
    },
    "autoload-dev": {
        "classmap": [
            "tests/TestCase.php"
        ]
    },
    "scripts": {
        "benchmark": [
            "@benchmark:baseline",
            "@benchmark:cache",
            "@benchmark:js-scanner",
            "@benchmark:suppressions",
            "@benchmark:aria-hidden",
            "@benchmark:fixer",
            "@benchmark:linter",
            "@benchmark:rule-scheduling"
        ],
        "benchmark:baseline": "@php benchmarks/BaselineBenchmark.php",
        "benchmark:aria-hidden": "@php benchmarks/AriaHiddenBenchmark.php",
        "benchmark:cache": "@php benchmarks/CacheBenchmark.php",
        "benchmark:fixer": "@php benchmarks/FixerBenchmark.php",
        "benchmark:js-scanner": "@php benchmarks/JsSourceScannerBenchmark.php",
        "benchmark:linter": "@php benchmarks/LinterBenchmark.php",
        "benchmark:rule-scheduling": "@php benchmarks/RuleSchedulingBenchmark.php",
        "benchmark:suppressions": "@php benchmarks/SuppressionBenchmark.php"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Forte\\Sheath\\ServiceProvider"
            ],
            "aliases": {
                "Sheath": "Forte\\Sheath\\Facades\\Sheath"
            }
        }
    }
}
